#!/usr/bin/env bash
set -eo pipefail

G=$'\e[1;32m' B=$'\e[1;34m' N=$'\e[0m'

apt=0 fp=0
while getopts afh opt; do
    case $opt in
        a) apt=1 ;;
        f) fp=1 ;;
        h|*) echo "Usage: ${0##*/} [-a] [-f] [-h]

        Options:
          -a    update Debian package
          -f    update Flatpaks
          -h    show this help and exit

        With no options, both system packages and Flatpaks are updated." >&2; exit 1 ;;
    esac
done
if ((apt == 0 && fp == 0)); then
    apt=1
    fp=1
fi

sudo-check() {
    sudo -n true 2>/dev/null || notify-send -a uppy "sudo: a password is required"
    sudo $1

}

apt_update() {
    printf '\n%sAPT CHECK%s\n' "$G" "$N"
    sudo apt update
    local n
    n=$(apt list --upgradable 2>/dev/null | grep -c upgradable || true)
    if ((n)); then
        notify-send -a uppy "$n packages can be upgraded" & sudo apt upgrade
    else
        notify-send -a uppy "No packages to upgrade"
    fi
    printf '\n%sCLEANUP%s\n' "$G" "$N"
    sudo-check "apt autoremove"
    sudo apt clean

}

flatpak_update() {
    printf '\n%sFLATPAK CHECK%s\n' "$B" "$N"
    sudo-check "--preserve-env=XDG_DATA_DIRS flatpak update -y"
    printf '\n%sCLEANUP%s\n' "$B" "$N"
    sudo-check "flatpak uninstall --unused -y"

}

if ((apt)); then apt_update; fi
if ((fp)); then flatpak_update; fi
notify-send -a uppy "Update completed :)"
